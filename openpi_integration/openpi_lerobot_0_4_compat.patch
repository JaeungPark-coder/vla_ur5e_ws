+def _tasks_to_dict(tasks) -> dict[int, str]:
+    """lerobot<0.4 exposes meta.tasks as {task_index: task}; lerobot>=0.4 (dataset v3.0) exposes a
+    DataFrame indexed by the task string with a "task_index" column."""
+    if isinstance(tasks, dict):
+        return tasks
+    return {int(row["task_index"]): str(task) for task, row in tasks.iterrows()}
