-override-dependencies = ["ml-dtypes==0.4.1", "tensorstore==0.1.74"]
+# rerun-sdk==0.23.1 overrides lerobot==0.4.4's own declared
+# rerun-sdk>=0.24.0,<0.27.0 requirement -- 0.24+ needs numpy>=2, which
+# conflicts with openpi's own numpy<2.0.0 pin above (JAX 0.5.3/flax 0.10.2
+# aren't tested against numpy 2.x). Safe here because this project's actual
+# lerobot usage (LeRobotDataset/LeRobotDatasetMetadata for training data
+# loading) never touches rerun-sdk's own APIs -- it's lerobot's optional
+# visualization/logging path, unused by openpi's training or
+# compute_norm_stats.py scripts.
+override-dependencies = ["ml-dtypes==0.4.1", "tensorstore==0.1.74", "rerun-sdk==0.23.1"]
 
 [tool.uv.sources]
 openpi-client = { workspace = true }
-lerobot = { git = "https://github.com/huggingface/lerobot", rev = "0cf864870cf29f4738d3ade893e6fd13fbd7cdb5" }
+# CHANGED (2026-09-07): was git-pinned to an older commit whose on-disk
+# dataset schema is CODEBASE_VERSION="v2.1". collect_demos.py (this
+# project's data collection script) was written against lerobot==0.4.4
+# (installed via plain `pip install lerobot` in the Isaac Sim conda env,
+# since openpi's own venv can't run Isaac Sim), which writes the newer
+# "v3.0" schema (parquet-chunked data/ + no meta/tasks.jsonl) -- confirmed
+# by an actual failed compute_norm_stats.py run: LeRobotDatasetMetadata
+# tried to read meta/tasks.jsonl, which doesn't exist in a v3.0 dataset,
+# then fell through to a Hub-versions lookup that 401'd (dataset was never
+# pushed to the Hub, collect_demos.py's push_to_hub=False). Pinning to the
+# same PyPI release the dataset was written with is simpler and more
+# reliable than trying to force local/offline dataset loading through a
+# lerobot version that doesn't understand this dataset's on-disk format at
+# all. If a future collect_demos.py run uses a different lerobot version,
+# update this pin (and re-run `uv sync`) to match.
 dlimp = { git = "https://github.com/kvablack/dlimp", rev = "ad72ce3a9b414db2185bc0b38461d4101a65477a" }
 
 [tool.uv.workspace]
